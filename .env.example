# Copy to `.env` and set real values. See README "Required env vars".

# Postgres (use DATABASE_URL or standard PG* variables)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/research_radar

# OpenAlex — prefer API key for live requests (see OpenAlex authentication docs)
OPENALEX_API_KEY=
# Optional contact string for User-Agent metadata only (not primary auth)
OPENALEX_MAILTO=you@example.com

# Embeddings (required for embed-works and similar)
OPENAI_API_KEY=sk-your-key-here

# Web + API wiring (optional; local defaults shown)
# API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local reviewer demo mode (no Postgres/OpenAlex/OpenAI): set to fixture.
# Leave unset for the normal Postgres-backed path.
# RESEARCH_RADAR_DATA_MODE=fixture

# Web ranking pins and experimental review surfaces
# Keep the experimental bridge review view disabled for normal/public runs.
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_BRIDGE_VIEW=false
# Pin reviewer runs deliberately; blank means the web/API resolves latest succeeded run.
NEXT_PUBLIC_RANKING_VERSION=

# Optional bounded ML scorer rollout. Defaults are fail-closed.
ML_SHADOW_SCORER_V1_RUNTIME_ENABLED=false
ML_SHADOW_SCORER_V1_PUBLIC_ROLLOUT_ENABLED=false
ML_SHADOW_SCORER_V1_PUBLIC_ROLLOUT_PERCENT=0
ML_SHADOW_SCORER_V1_ROLLOUT_EXPOSURE_CAP=0
ML_SHADOW_SCORER_V1_ROLLOUT_COHORT_ALLOWLIST=

# Optional: pin Similar papers in the web UI to an embedding set you have materialized
# NEXT_PUBLIC_EMBEDDING_VERSION=v1-title-abstract-1536

# Optional: OpenAI-compatible endpoint (defaults to api.openai.com)
# OPENAI_BASE_URL=https://api.openai.com/v1
