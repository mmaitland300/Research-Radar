{
  "name": "research-radar",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "demo:local": "node scripts/demo-local.mjs",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "test:web": "playwright test",
    "validate:web": "npm run lint:web && npm run build:web",
    "validate:py": "python -m pytest services/pipeline/tests apps/api/tests -q",
    "validate": "npm run validate:web && npm run validate:py"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  }
}
